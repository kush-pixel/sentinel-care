# Auto detect text files and normalize line endings
* text=auto

# Explicitly declare TypeScript and JS as LF
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# PowerShell scripts stay CRLF on Windows
*.ps1 text eol=crlf

# Binary files — no line ending conversion
*.png binary
*.jpg binary
*.mp3 binary
*.docx binary
