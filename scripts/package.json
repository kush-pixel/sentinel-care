{
  "name": "@sentinel/scripts",
  "version": "0.1.0",
  "private": true,
  "description": "Developer utility scripts: seed DynamoDB, invoke Lambdas locally, generate test calls",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "seed": "node dist/seed-dynamo.js",
    "invoke-local": "node dist/invoke-local.js",
    "seed:fhir": "ts-node src/fhir/seed-fhir.ts",
    "seed:rules": "ts-node src/rules/seed-clinical-rules.ts",
    "seed:demo": "ts-node src/reviews/seed-demo-results.ts",
    "seed:reviews": "ts-node src/reviews/seed-pending-reviews.ts",
    "seed:all": "npm run seed:fhir && npm run seed:rules && npm run seed:demo && npm run seed:reviews",
    "verify": "ts-node src/verify.ts",
    "clear": "ts-node src/clear.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.490.0",
    "@aws-sdk/client-lambda": "^3.490.0",
    "@aws-sdk/lib-dynamodb": "^3.490.0",
    "@sentinel/schemas": "*",
    "@sentinel/types": "*",
    "@types/node-fetch": "^2.6.13",
    "dotenv": "^16.4.1",
    "node-fetch": "^2.7.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "*",
    "typescript": "*"
  }
}
