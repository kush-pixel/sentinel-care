{
  "name": "@sentinel/scripts",
  "version": "0.1.0",
  "private": true,
  "description": "Developer utility scripts: seed DynamoDB, invoke Lambdas locally, generate test calls",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "seed": "node dist/seed-dynamo.js",
    "invoke-local": "node dist/invoke-local.js",
    "seed:fhir": "ts-node src/fhir/seed-fhir.ts",
    "seed:encounters": "ts-node src/fhir/seed-encounters.ts",
    "seed:rules": "ts-node src/rules/seed-clinical-rules.ts",
    "seed:demo": "ts-node src/reviews/seed-demo-results.ts",
    "seed:reviews": "ts-node src/reviews/seed-pending-reviews.ts",
    "seed:triage": "ts-node -r tsconfig-paths/register src/triage/seed-triage-data.ts",
    "seed:pending-review": "ts-node src/demo/seed-pending-review.ts",
    "clear:reviews": "ts-node src/demo/clear-protocol-reviews.ts",
    "fix:p004": "ts-node src/demo/fix-p004-callresult.ts",
    "demo:flow": "ts-node src/demo/demo-p004-flow.ts",
    "demo:reset": "ts-node src/demo/demo-reset.ts",
    "test:regeneration": "ts-node src/test-regeneration/test-loop.ts",
    "morning:start": "ts-node src/demo/morning-start.ts",
    "recreate:rules-table": "ts-node src/rules/recreate-rules-table.ts",
    "test:versioning": "ts-node src/test-versioning/test-rule-update.ts",
    "lace:hydrate": "ts-node src/lace/hydrate-lace.ts",
    "remove:test-patients": "ts-node src/fhir/remove-test-patients.ts",
    "test:uuid-patient": "ts-node src/test-uuid-patient/test-uuid-flow.ts",
    "seed:uuid-demo": "ts-node src/test-uuid-patient/seed-uuid-demo.ts",
    "cleanup:uuid-demo": "ts-node src/test-uuid-patient/cleanup-uuid-demo.ts",
    "setup:kvs": "ts-node src/infrastructure/setup-kvs.ts",
    "deploy:lambdas": "ts-node src/infrastructure/deploy-lambdas.ts",
    "setup:lex": "ts-node src/infrastructure/setup-lex-bot.ts",
    "setup:contact-flow": "ts-node src/infrastructure/setup-contact-flow.ts",
    "health:check": "ts-node src/infrastructure/health-check.ts",
    "rebuild:fhir": "ts-node src/infrastructure/rebuild-fhir.ts",
    "setup:lex-fulfillment": "ts-node src/infrastructure/setup-lex-fulfillment.ts",
    "test:real-call": "ts-node src/test-call/test-real-call.ts",
    "test:p002-call": "ts-node src/test-call/test-p002-call.ts",
    "post-call-audit": "ts-node src/test-call/post-call-audit.ts",
    "cleanup:calls": "ts-node src/cleanup-calls.ts",
    "cleanup:stale": "ts-node src/maintenance/cleanup-stale.ts",
    "cleanup:p008": "ts-node src/maintenance/cleanup-p008.ts",
    "test:new-patient": "ts-node src/test-robustness/test-new-patient.ts",
    "test:new-patient-call": "ts-node src/test-robustness/test-new-patient-call.ts",
    "seed:all": "npm run seed:fhir && npm run seed:encounters && npm run seed:rules && npm run lace:hydrate && npm run seed:demo && npm run seed:reviews",
    "lace": "ts-node src/lace/calculate-all.ts",
    "verify": "ts-node src/verify.ts",
    "clear": "ts-node src/clear.ts",
    "validate:sfn": "ts-node --project ../step-functions/tsconfig.json ../step-functions/validate.ts",
    "deploy:sfn": "ts-node --project ../step-functions/tsconfig.json ../step-functions/deploy.ts"
  },
  "dependencies": {
    "@aws-sdk/client-connect": "^3.490.0",
    "@aws-sdk/client-dynamodb": "^3.490.0",
    "@aws-sdk/client-ec2": "^3.1009.0",
    "@aws-sdk/client-iam": "^3.490.0",
    "@aws-sdk/client-kinesis-video": "^3.490.0",
    "@aws-sdk/client-lambda": "^3.490.0",
    "@aws-sdk/client-lex-models-v2": "^3.1009.0",
    "@aws-sdk/client-sfn": "^3.490.0",
    "@aws-sdk/lib-dynamodb": "^3.490.0",
    "@sentinel/lace": "*",
    "@sentinel/schemas": "*",
    "@sentinel/types": "*",
    "@types/node-fetch": "^2.6.13",
    "archiver": "^7.0.1",
    "dotenv": "^16.4.1",
    "node-fetch": "^2.7.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.3",
    "@types/node": "*",
    "esbuild": "^0.24.0",
    "typescript": "*"
  }
}
