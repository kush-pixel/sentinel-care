{
  "name": "@sentinel/extractor",
  "version": "0.1.0",
  "private": true,
  "description": "Nova Lite-powered speech extractor — converts patient responses to structured values",
  "scripts": {
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "build": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.490.0",
    "@sentinel/schemas": "*",
    "dotenv": "^16.4.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "*",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "*"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": {
            "module": "CommonJS",
            "moduleResolution": "Node"
          }
        }
      ]
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@sentinel/schemas$": "<rootDir>/../../shared/schemas/src/index.ts"
    },
    "testTimeout": 60000,
    "setupFiles": ["<rootDir>/jest.setup.js"]
  }
}
