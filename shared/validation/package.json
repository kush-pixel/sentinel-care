{
  "name": "@sentinel/validation",
  "version": "0.1.0",
  "private": true,
  "description": "Input validation utilities — validates patientId, callId, confidence values and sanitises error messages",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.490.0",
    "@aws-sdk/lib-dynamodb": "^3.490.0",
    "@sentinel/schemas": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "*",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "*"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "module": "CommonJS",
          "moduleResolution": "Node"
        }
      }
    },
    "moduleNameMapper": {
      "^@sentinel/schemas$": "<rootDir>/../../shared/schemas/src/index.ts"
    }
  }
}
