# ─────────────────────────────────────────────────────────────────────────────
# Sentinel Care — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS Core ──────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
AWS_PROFILE=default
NODE_ENV=production

# ── DynamoDB Tables ───────────────────────────────────────────────────────────
# Leave DYNAMO_ENDPOINT blank to use AWS (production); set to http://localhost:8000 for local dev
DYNAMO_ENDPOINT=
DYNAMO_TABLE_PATIENTS=PatientProfiles
DYNAMO_TABLE_PROTOCOLS=TriageProtocols
DYNAMO_TABLE_RESULTS=CallResults
DYNAMO_TABLE_RULES=ClinicalRules
DYNAMO_TABLE_REVIEWS=ProtocolReview

# ── FHIR Server ───────────────────────────────────────────────────────────────
# HAPI FHIR R4 server base URL (deployed on EC2 or localhost for dev)
FHIR_BASE_URL=
FHIR_VERSION=R4

# ── Amazon Bedrock Models ─────────────────────────────────────────────────────
# Care Planner (protocol generation) — uses Nova Pro for high-quality clinical reasoning
BEDROCK_MODEL_CARE_PLANNER=amazon.nova-pro-v1:0
# Answer Extractor — Nova Lite is fast and sufficient for JSON extraction
BEDROCK_MODEL_EXTRACTOR=amazon.nova-lite-v1:0
# SBAR Summarizer — Nova Lite for clinical summary generation
BEDROCK_MODEL_SUMMARIZER=amazon.nova-lite-v1:0
# Voice call model — Nova 2 Sonic for bidirectional voice conversation
BEDROCK_MODEL_VOICE=amazon.nova-2-sonic-v1:0

# ── Amazon Polly (TTS for question audio) ────────────────────────────────────
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=neural
POLLY_LANGUAGE_CODE=en-US

# ── Amazon Lex v2 ─────────────────────────────────────────────────────────────
# Bot ID and alias for SentinelVoiceBot
LEX_BOT_ID=
LEX_BOT_ALIAS_ID=

# ── Amazon Connect ────────────────────────────────────────────────────────────
CONNECT_INSTANCE_ID=
CONNECT_INSTANCE_ALIAS=
CONNECT_ADMIN_URL=
CONNECT_ADMIN_USERNAME=
CONNECT_QUEUE_ID=
CONNECT_ROUTING_PROFILE_ID=
CONNECT_HOURS_OF_OPERATION_ID=
# E.164 format: +1XXXXXXXXXX — the phone number patients receive calls from
CONNECT_PHONE_NUMBER=
CONNECT_CONTACT_FLOW_ID=

# ── Amazon SNS (RED alert escalation) ────────────────────────────────────────
ESCALATION_TOPIC_ARN=

# ── Amazon S3 (Polly audio cache) ────────────────────────────────────────────
S3_AUDIO_BUCKET=

# ── Amazon Kinesis Video Streams (voice bridge) ───────────────────────────────
KVS_STREAM_ARN=

# ── IAM Roles ─────────────────────────────────────────────────────────────────
LAMBDA_ROLE_ARN=
SFN_ROLE_ARN=

# ── Lambda ARNs ───────────────────────────────────────────────────────────────
STATE_MACHINE_ARN=
LAMBDA_ARN_CARE_PLANNER=
LAMBDA_ARN_TRIAGE_ENGINE=
LAMBDA_ARN_SUMMARIZER=
LAMBDA_ARN_CONSENT=
LAMBDA_ARN_EXTRACT=
LAMBDA_ARN_INCOMPLETE=
LAMBDA_ARN_COMPLETE=
LAMBDA_ARN_CALL_COMPLETE=

# ── Call configuration ────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.7
CALL_RETRY_ATTEMPTS=3
LAMBDA_TIMEOUT_SECONDS=30
LAMBDA_MEMORY_MB=512

# ── Nova Sonic (voice call tuning) ───────────────────────────────────────────
NOVA_SONIC_MAX_TOKENS=4096
NOVA_SONIC_TEMPERATURE=0.3
# Turn-taking sensitivity: FAST | MEDIUM | SLOW
NOVA_SONIC_TURN_TAKING=MEDIUM

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000
NEXT_PUBLIC_REGION=us-east-1
NEXT_PUBLIC_API_BASE_URL=

# ── Testing (development only — do not set in production) ────────────────────
# E.164 format phone number for placing test calls
TEST_PHONE_NUMBER=
