# ─────────────────────────────────────────────────────────────────────────────
# Sentinel Care — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# All values for the deployed system are provided in the submission package.
# ─────────────────────────────────────────────────────────────────────────────

# ── AWS Core ──────────────────────────────────────────────────────────────────
# Your AWS region — must match where the infrastructure is deployed
AWS_REGION=us-east-1
# Your 12-digit AWS account ID (aws sts get-caller-identity --query Account)
AWS_ACCOUNT_ID=
# AWS CLI profile to use (leave as "default" unless you have named profiles)
AWS_PROFILE=default
NODE_ENV=production

# ── DynamoDB Tables ───────────────────────────────────────────────────────────
# These table names are fixed — do not change unless you renamed the tables
DYNAMO_ENDPOINT=
DYNAMO_TABLE_PATIENTS=PatientProfiles
DYNAMO_TABLE_PROTOCOLS=TriageProtocols
DYNAMO_TABLE_RESULTS=CallResults
DYNAMO_TABLE_RULES=ClinicalRules
DYNAMO_TABLE_REVIEWS=ProtocolReview

# ── FHIR Server ───────────────────────────────────────────────────────────────
# Public IP of the EC2 HAPI FHIR server — provided in submission notes
# Format: http://<EC2_PUBLIC_IP>:8080/fhir
FHIR_BASE_URL=
FHIR_VERSION=R4

# ── Amazon Bedrock Models ─────────────────────────────────────────────────────
# These are fixed model IDs — do not change
# Care Planner uses Nova Pro for high-quality clinical reasoning
BEDROCK_MODEL_CARE_PLANNER=amazon.nova-pro-v1:0
# Answer Extractor uses Nova Lite for fast JSON extraction
BEDROCK_MODEL_EXTRACTOR=amazon.nova-lite-v1:0
# SBAR Summarizer uses Nova Lite for clinical summary generation
BEDROCK_MODEL_SUMMARIZER=amazon.nova-lite-v1:0
# Voice call model — Nova 2 Sonic for bidirectional voice conversation
BEDROCK_MODEL_VOICE=amazon.nova-2-sonic-v1:0

# ── Amazon Polly (TTS for question audio) ─────────────────────────────────────
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=neural
POLLY_LANGUAGE_CODE=en-US

# ── Amazon Lex v2 ─────────────────────────────────────────────────────────────
# Bot ID: AWS Console → Amazon Lex → Bots → SentinelVoiceBot → Bot ID
LEX_BOT_ID=
# Alias ID: SentinelVoiceBot → Aliases → SentinelVoiceLive → Alias ID
LEX_BOT_ALIAS_ID=

# ── Amazon Connect ────────────────────────────────────────────────────────────
# Instance ID: AWS Console → Amazon Connect → click instance → Instance ID in ARN
CONNECT_INSTANCE_ID=
# Instance alias (the subdomain of your Connect URL)
CONNECT_INSTANCE_ALIAS=
# Admin console URL: https://<alias>.my.connect.aws/
CONNECT_ADMIN_URL=
CONNECT_ADMIN_USERNAME=
# Queue ID: Connect admin → Routing → Queues → BasicQueue → ID in URL
CONNECT_QUEUE_ID=
# Routing Profile ID: Users → Routing profiles → Basic Routing Profile → ID in URL
CONNECT_ROUTING_PROFILE_ID=
# Hours of operation ID: Routing → Hours of operation → Basic Hours → ID in URL
CONNECT_HOURS_OF_OPERATION_ID=
# The outbound phone number patients receive calls from (E.164 format)
CONNECT_PHONE_NUMBER=
# Contact Flow ID: Flows → sentinel-nova-sonic-outbound → ID in URL
CONNECT_CONTACT_FLOW_ID=

# ── Amazon SNS (RED alert escalation) ────────────────────────────────────────
# ARN of the sentinel-red-escalation SNS topic
# AWS Console → SNS → Topics → sentinel-red-escalation → ARN
ESCALATION_TOPIC_ARN=

# ── Amazon S3 (Polly audio cache) ─────────────────────────────────────────────
# S3 bucket name for caching Polly TTS audio
S3_AUDIO_BUCKET=

# ── Amazon Kinesis Video Streams (voice bridge) ───────────────────────────────
# ARN of the sentinel-voice-calls KVS stream
KVS_STREAM_ARN=

# ── IAM Roles ─────────────────────────────────────────────────────────────────
# ARN of the sentinel-lambda-role execution role
# AWS Console → IAM → Roles → sentinel-lambda-role → ARN
LAMBDA_ROLE_ARN=
SFN_ROLE_ARN=

# ── Lambda ARNs ───────────────────────────────────────────────────────────────
# These are set automatically by deploy:lambdas — or find them in AWS Console
# → AWS Lambda → Functions → click each function → copy ARN
STATE_MACHINE_ARN=
LAMBDA_ARN_CARE_PLANNER=
LAMBDA_ARN_TRIAGE_ENGINE=
LAMBDA_ARN_SUMMARIZER=
LAMBDA_ARN_CONSENT=
LAMBDA_ARN_EXTRACT=
LAMBDA_ARN_INCOMPLETE=
LAMBDA_ARN_COMPLETE=
LAMBDA_ARN_CALL_COMPLETE=

# ── Call configuration ────────────────────────────────────────────────────────
# Minimum Bedrock confidence score to auto-approve a generated protocol (0–1)
CONFIDENCE_THRESHOLD=0.7
CALL_RETRY_ATTEMPTS=3
LAMBDA_TIMEOUT_SECONDS=30
LAMBDA_MEMORY_MB=512

# ── Nova Sonic (voice call tuning) ────────────────────────────────────────────
NOVA_SONIC_MAX_TOKENS=4096
NOVA_SONIC_TEMPERATURE=0.3
# Turn-taking sensitivity: FAST | MEDIUM | SLOW
NOVA_SONIC_TURN_TAKING=MEDIUM

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000
NEXT_PUBLIC_REGION=us-east-1
NEXT_PUBLIC_API_BASE_URL=

# ── Testing ───────────────────────────────────────────────────────────────────
# YOUR mobile number to receive test calls (E.164 format: +1XXXXXXXXXX)
# The call will come from CONNECT_PHONE_NUMBER above
TEST_PHONE_NUMBER=
