{
  "name": "@sentinel/triage-engine",
  "version": "0.1.0",
  "private": true,
  "description": "Pure-TypeScript triage evaluation engine — scores PatientAnswers against TriageProtocol",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist",
    "test": "jest --coverage",
    "test:local": "ts-node --project tsconfig.json src/local-test.ts"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.490.0",
    "@aws-sdk/lib-dynamodb": "^3.490.0",
    "@aws-sdk/client-sns": "^3.490.0",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4",
    "@sentinel/audit": "*",
    "@sentinel/schemas": "*",
    "@sentinel/lace": "*",
    "@sentinel/validation": "*"
  },
  "devDependencies": {
    "typescript": "*",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "globals": {
      "ts-jest": {
        "tsconfig": {
          "module": "CommonJS",
          "moduleResolution": "Node"
        }
      }
    },
    "moduleNameMapper": {
      "^@sentinel/schemas$": "<rootDir>/../../shared/schemas/src/index.ts",
      "^@sentinel/lace$": "<rootDir>/../../shared/lace/src/index.ts"
    }
  }
}
