# Sentinel Voice — Judge Access Configuration
# Pre-configured for demo evaluation
# Copy this file: cp .env.judge .env
# Then run: cd scripts && npm run morning:start
# Then run: cd dashboard && npm run dev
#
# To test a real call change TEST_PHONE_NUMBER
# to your own mobile number (+1XXXXXXXXXX format)
# Then run: cd scripts && npm run test:real-call

# ── AWS Core ──────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=629843009128
AWS_PROFILE=default
NODE_ENV=production

# ── DynamoDB Tables ───────────────────────────────────────────────────────────
DYNAMO_ENDPOINT=
DYNAMO_TABLE_PATIENTS=PatientProfiles
DYNAMO_TABLE_PROTOCOLS=TriageProtocols
DYNAMO_TABLE_RESULTS=CallResults
DYNAMO_TABLE_RULES=ClinicalRules
DYNAMO_TABLE_REVIEWS=ProtocolReview

# ── FHIR Server (EC2 t3.small, us-east-1) ────────────────────────────────────
FHIR_BASE_URL=http://3.239.230.36:8080/fhir
FHIR_VERSION=R4

# ── Amazon Bedrock Models ─────────────────────────────────────────────────────
BEDROCK_MODEL_CARE_PLANNER=amazon.nova-pro-v1:0
BEDROCK_MODEL_EXTRACTOR=amazon.nova-lite-v1:0
BEDROCK_MODEL_SUMMARIZER=amazon.nova-lite-v1:0
BEDROCK_MODEL_VOICE=amazon.nova-2-sonic-v1:0

# ── Amazon Polly ──────────────────────────────────────────────────────────────
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=neural
POLLY_LANGUAGE_CODE=en-US

# ── Amazon Lex v2 ─────────────────────────────────────────────────────────────
LEX_BOT_ID=KEVYFJMTZ5
LEX_BOT_ALIAS_ID=YOH9BNHFPG
LEX_BOT_VERSION=9

# ── Amazon Connect ────────────────────────────────────────────────────────────
CONNECT_INSTANCE_ID=40725174-b7f7-4388-8ea4-e761fd3c18fe
CONNECT_INSTANCE_ALIAS=sentinel-voice-demo
CONNECT_ADMIN_URL=https://sentinel-voice-demo.my.connect.aws
CONNECT_ADMIN_USERNAME=sentineladmin
CONNECT_QUEUE_ID=be4bc249-5c71-4a27-8f15-83a565f6169c
CONNECT_ROUTING_PROFILE_ID=f7429b74-eb63-476f-be69-96d87c4e98de
CONNECT_HOURS_OF_OPERATION_ID=f29f30de-db12-48e9-a339-38f3a1b60aca
CONNECT_PHONE_NUMBER=+17208446427
CONNECT_CONTACT_FLOW_ID=45faa7a9-62ac-468c-a186-cc3f012766f7

# ── Amazon SNS (RED alert escalation) ────────────────────────────────────────
ESCALATION_TOPIC_ARN=arn:aws:sns:us-east-1:629843009128:sentinel-red-escalation

# ── Amazon S3 ─────────────────────────────────────────────────────────────────
S3_AUDIO_BUCKET=sentinel-audio-629843009128

# ── Amazon Kinesis Video Streams ──────────────────────────────────────────────
KVS_STREAM_NAME=sentinel-voice-calls
KVS_STREAM_ARN=

# ── IAM Roles ─────────────────────────────────────────────────────────────────
LAMBDA_ROLE_ARN=arn:aws:iam::629843009128:role/sentinel-lambda-role
SFN_ROLE_ARN=arn:aws:iam::629843009128:role/sentinel-stepfunctions-role

# ── Lambda ARNs ───────────────────────────────────────────────────────────────
STATE_MACHINE_ARN=
LAMBDA_ARN_CARE_PLANNER=arn:aws:lambda:us-east-1:629843009128:function:sentinel-care-planner
LAMBDA_ARN_TRIAGE_ENGINE=arn:aws:lambda:us-east-1:629843009128:function:sentinel-triage-engine
LAMBDA_ARN_SUMMARIZER=arn:aws:lambda:us-east-1:629843009128:function:sentinel-summarizer
LAMBDA_ARN_EXTRACTOR=arn:aws:lambda:us-east-1:629843009128:function:sentinel-extractor
LAMBDA_ARN_CALL_INITIATOR=arn:aws:lambda:us-east-1:629843009128:function:sentinel-call-initiator
LAMBDA_ARN_ANSWER_COLLECTOR=arn:aws:lambda:us-east-1:629843009128:function:sentinel-answer-collector
LAMBDA_ARN_CALL_COMPLETE=arn:aws:lambda:us-east-1:629843009128:function:sentinel-call-complete
LAMBDA_ARN_CALL_BRIDGE=arn:aws:lambda:us-east-1:629843009128:function:sentinel-call-bridge
LAMBDA_ARN_LEX_FULFILLMENT=arn:aws:lambda:us-east-1:629843009128:function:sentinel-lex-fulfillment
LAMBDA_ARN_NOVA_SONIC=arn:aws:lambda:us-east-1:629843009128:function:sentinel-nova-sonic
LAMBDA_ARN_CONSENT=
LAMBDA_ARN_EXTRACT=
LAMBDA_ARN_INCOMPLETE=
LAMBDA_ARN_COMPLETE=

# ── Call configuration ────────────────────────────────────────────────────────
CONFIDENCE_THRESHOLD=0.7
CALL_RETRY_ATTEMPTS=3
LAMBDA_TIMEOUT_SECONDS=30
LAMBDA_MEMORY_MB=512

# ── Nova Sonic (voice call tuning) ────────────────────────────────────────────
NOVA_SONIC_MAX_TOKENS=4096
NOVA_SONIC_TEMPERATURE=0.3
NOVA_SONIC_TURN_TAKING=MEDIUM

# ── Dashboard ─────────────────────────────────────────────────────────────────
DASHBOARD_PORT=3000
NEXT_PUBLIC_REGION=us-east-1
NEXT_PUBLIC_API_BASE_URL=

# ── Testing ───────────────────────────────────────────────────────────────────
# CHANGE THIS to your own mobile number to receive test calls (+1XXXXXXXXXX)
TEST_PHONE_NUMBER=+1XXXXXXXXXX
