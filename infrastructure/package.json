{
  "name": "@sentinel/infrastructure",
  "version": "0.1.0",
  "private": true,
  "description": "AWS CDK stack definitions for all Sentinel Voice infrastructure",
  "main": "./dist/bin/app.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist cdk.out",
    "deploy": "npm run build && cdk deploy --all --require-approval never",
    "synth": "npm run build && cdk synth",
    "diff": "npm run build && cdk diff",
    "destroy": "cdk destroy --all"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.123.0",
    "constructs": "^10.3.0"
  },
  "devDependencies": {
    "aws-cdk": "^2.123.0",
    "typescript": "*"
  }
}
